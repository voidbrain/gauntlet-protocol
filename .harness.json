    "docs/audits/README.md": "core/docs/audits/README.md",
    "docs/archive/README.md": "core/docs/archive/README.md",
    ".editorconfig": "core/.editorconfig",
    ".gitignore": "core/gitignore.txt",
    "GEMINI.md": "core/GEMINI.md",
    "QWEN.md": "core/QWEN.md",
    ".github/copilot-instructions.md": "core/.github/copilot-instructions.md",
    "docs/backlog/closure.md": "core/docs/backlog/closure.md",
    "docs/backlog/documentation.md": "core/docs/backlog/documentation.md",
    "docs/backlog/estimates.md": "core/docs/backlog/estimates.md",
    "docs/backlog/evaluations.md": "core/docs/backlog/evaluations.md",
    "docs/backlog/ordering.md": "core/docs/backlog/ordering.md",
    "docs/backlog/ownership.md": "core/docs/backlog/ownership.md",
    "docs/backlog/records.md": "core/docs/backlog/records.md",
    "docs/backlog/review.md": "core/docs/backlog/review.md",
    "docs/backlog/steps.md": "core/docs/backlog/steps.md",
    "docs/agents/pull-requests.md": "core/docs/agents/pull-requests.md",
    "docs/backlog/feature-plans.md": "core/docs/backlog/feature-plans.md",
    "docs/backlog/outcomes.md": "core/docs/backlog/outcomes.md",
    ".npmrc": "core/npmrc.txt"
  },
  "ciStatus": {
    "workflow": "CI",
    "browserJobs": "e2e|browser",
    "logNotes": []
  },
  "maintenance": {
    "enabled": true,
    "reviewDays": 7,
    "requireMeasurement": true,
    "inputs": [
      "AGENTS.md",
      "docs/BACKLOG-RULES.md",
      "docs/agents/areas.md",
      "docs/agents/maintenance.md",
      "docs/agents/coverage-guide.md",
      "docs/agents/change-impact.md",
      "docs/agents/mcp.md",
      "docs/agents/solution-profile.md",
      "docs/agents/skills.md",
      "docs/agents/audit.md",
      "docs/agents/parallel-work.md",
      "docs/agents/parallel-work-plans.md",
      "docs/agents/architecture-review.md",
      "docs/agents/procedures.md",
      "tools/work-items.mjs",
      "tools/task-claims.mjs",
      "docs/agents/task-context.md",
      "docs/agents/prompt-caching.md",
      "docs/agents/work-usage.md",
      "tools/work-usage.mjs",
      "tools/usage-launch.mjs"
    ]
  },
  "audit": {
    "days": 7,
    "enforce": false
  },
  "rules": {
    "agents": "AGENTS.md",
    "procedures": [
      "docs/BACKLOG-RULES.md",
      "docs/agents/*.md",
      "docs/backlog/*.md"
    ],
    "maxLines": 200,
    "budgets": {
      "always": 3500,
      "procedure": 2000,
      "trigger": 5000
    }
  },
  "behaviour": {
    "times": 3
  },
  "verification": {
    "enabled": false
  },
  "workItems": {
    "enabled": true,
    "layout": "docs/work/layout.json",
    "records": "docs/work/records",
    "tasks": "docs/work/tasks",
    "profiles": "docs/agents/model-profiles.json",
    "featurePlans": true,
    "order": "queue",
    "estimation": {
      "since": "2026-11-15"
    }
  },
  "workUsage": {
    "enabled": true,
    "pauseGapMinutes": 15
  },
  "reviews": {
    "token": {
      "days": 30
    },
    "architecture": {
      "days": 30
    }
  }
}
