  "forked": {},
  "freshness": {
    "auditDays": 7
  },
  "impact": [
    {
      "id": "protocol",
      "when": [
        "src/**",
        "bin/**",
        "test/**",
        "examples/**",
        "package*.json",
        "tsconfig*.json"
      ],
      "then": "Verify protocol and CLI joins; reconcile protocol guide, examples and README.",
      "run": "npm run typecheck && npm test && npm run build",
      "checked": "Deterministic fake-provider and subprocess fixtures only; no model campaign."
    },
    {
      "id": "capability-index",
      "when": [
        "examples/**",
        "src/catalog.ts",
        "docs/test-index.md"
      ],
      "then": "Regenerate executable-pack capability index and verify drift without model execution.",
      "run": "npm run index:build && npm run check:index",
      "checked": "Exact generated-index contract in deterministic tests; no capability qualification inferred."
    },
    {
      "id": "work-items",
      "when": [
        "docs/work/**",
        "docs/agents/model-profiles.json",
        "tools/work-items.mjs"
      ],
      "then": "Regenerate the source-owned backlog and validate upfront feature steps, effort and status.",
      "run": "node tools/work-items.mjs build",
      "checked": "npm run check:work and check:backlog in CI",
      "after": []
    }
  ],
  "couplings": [],
  "outside": [],
  "pages": [
    {
      "title": "Development impact map",
      "path": "docs/agents/impact-map.md",
      "about": "Project-owned derived outputs and verification obligations"
    }
  ],
  "adapted": {
    "AGENTS.md": "core/AGENTS.md",
    "CLAUDE.md": "core/CLAUDE.md",
    "README.md": "core/README.md",
    "docs/BACKLOG.md": "core/docs/BACKLOG.md",
