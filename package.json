{
  "name": "@voidbrain/gauntlet-protocol",
  "version": "0.11.1",
  "description": "Capability-scoped evaluation contracts, bounded adapters and reviewed model evidence",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "gauntlet": "bin/gauntlet.mjs"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "LICENSE",
    "examples",
    "docs/PROTOCOL.md",
    "docs/MAC-PROFILES.md",
    "docs/test-index.md",
    "docs/EVIDENCE.md",
    "docs/PERFORMANCE.md",
    "docs/RUNTIMES.md",
    "docs/ENVIRONMENTS.md",
    "docs/FAILURES.md",
    "docs/COMPARISONS.md",
    "docs/LEDGER.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test --test-reporter=./tools/quiet-reporter.mjs --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=.test-report.txt --test-timeout=60000 test/*.test.ts",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include='src/**' --test-timeout=60000 --test-reporter=./tools/quiet-reporter.mjs --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.ts && node tools/lcov-summary.mjs",
    "coverage": "npm run test:coverage && node tools/coverage-table.mjs --write",
    "prepack": "npm run build",
    "check:freshness": "node tools/check-freshness.mjs",
    "check:backlog": "node tools/check-backlog.mjs",
    "check:tooling": "node tools/check-tooling.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check:harness": "node tools/check-harness.mjs",
    "check:rules": "node tools/check-rules.mjs",
    "check:rule-load": "node tools/rule-load.mjs --check",
    "check:maintenance": "node tools/maintenance.mjs check",
    "check:audits": "node tools/check-audits.mjs",
    "check:integrations": "node tools/mcp.mjs check",
    "ci:status": "node tools/ci-status.mjs",
    "reconcile:draft": "node tools/reconcile-draft.mjs",
    "code:map": "node tools/code-map.mjs",
    "index:build": "node bin/gauntlet.mjs index --packs=examples/smoke-v1.json,examples/general-assistant-expanded-v1.json,examples/structured-output-robustness-v1.json,examples/tool-use-v1.json,examples/bilingual-it-en-v1.json,examples/multi-step-agent-v1.json,examples/refusal-permission-v1.json,examples/long-context-v1.json,examples/coding-v1.json,examples/logic-math-v1.json,examples/embedded-v1.json,examples/cad-3d-v1.json,examples/italian-quality-v1.json,examples/code-review-v1.json,examples/image-generation-v1.json --out=docs/test-index.md",
    "check:index": "node bin/gauntlet.mjs index --packs=examples/smoke-v1.json,examples/general-assistant-expanded-v1.json,examples/structured-output-robustness-v1.json,examples/tool-use-v1.json,examples/bilingual-it-en-v1.json,examples/multi-step-agent-v1.json,examples/refusal-permission-v1.json,examples/long-context-v1.json,examples/coding-v1.json,examples/logic-math-v1.json,examples/embedded-v1.json,examples/cad-3d-v1.json,examples/italian-quality-v1.json,examples/code-review-v1.json,examples/image-generation-v1.json --out=docs/test-index.md --check",
    "work:usage": "node tools/work-usage.mjs",
    "work:build": "node tools/work-items.mjs build",
    "check:work": "node tools/work-items.mjs check",
    "work:tasks": "node tools/work-items.mjs tasks",
    "work:next": "node tools/work-items.mjs next",
    "work:close": "node tools/work-items.mjs close",
    "work:pr": "node tools/work-items.mjs pr",
    "work:launch": "node tools/usage-launch.mjs",
    "check:impact": "node tools/impact-map.mjs && git diff --exit-code -- docs/agents/impact-map.md",
    "impact-map": "node tools/impact-map.mjs",
    "mcp:recommend": "node tools/mcp.mjs recommend",
    "reconcile:preview": "node tools/reconcile-preview.mjs",
    "friction": "node tools/friction.mjs",
    "archive:recap": "node tools/archive-recap.mjs",
    "check:archive-recap": "node tools/archive-recap.mjs --check",
    "guard:install": "node tools/guard.mjs install",
    "behaviour": "node tools/behaviour.mjs",
    "coverage:browser": "node tools/browser-coverage.mjs",
    "check:dependencies": "node tools/backlog-dependencies.mjs --check",
    "check:queue": "node tools/backlog-queue.mjs --check",
    "verification:plan": "node tools/verification.mjs",
    "work:claims": "node tools/task-claims.mjs",
    "rule-load": "node tools/rule-load.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "eslint": "10.15.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
